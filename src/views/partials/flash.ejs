<% if (typeof flash !== "undefined" && flash && (flash.success || flash.error)) { %>
    <% if (flash.success) { %>
        <div class="alert alert-success" role="alert"><%= flash.success %></div>
    <% } %>
    <% if (flash.error) { %>
        <div class="alert alert-danger" role="alert"><%= flash.error %></div>
    <% } %>
<% } %>
<% if (typeof formError !== "undefined" && formError) { %>
    <div class="alert alert-danger" role="alert"><%= formError %></div>
<% } %>
