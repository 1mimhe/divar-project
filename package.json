{
  "name": "divar-store",
  "version": "0.0.0",
  "description": "A store project with node.js and express",
  "main": "app.js",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.ts",
    "dev:legacy": "nodemon app.js",
    "build": "node --test tests/health.test.ts",
    "start": "node src/server.ts",
    "start:legacy": "node app.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\"",
    "test": "node --test tests/*.test.ts",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "ejs-lint": "^2.0.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.0",
    "jalali-moment": "^3.3.11",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "mongoose": "^8.2.4",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "slugify": "^1.6.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "translatte": "^3.0.1",
    "utf8": "^3.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^2.1.9"
  },
  "keywords": [],
  "author": "Mohammad Hosseini",
  "license": "ISC"
}
