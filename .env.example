PORT=3000
NODE_ENV=development
MONGODB_URL=mongodb://127.0.0.1:27017/divar-store
JWT_PRIVATE_KEY=change-me-dev-access-secret-min-32-chars
JWT_REFRESH_KEY=change-me-dev-refresh-secret-min-32-chars
COOKIE_PRIVATE_KEY=change-me-dev-cookie-secret-min-32-chars
SMS_PROVIDER=mock
# Optional: mobile promoted to admin by `npm run seed`.
ADMIN_MOBILE=
# Optional: database used by the test suite (defaults to divar-store-test).
TEST_MONGODB_URL=
