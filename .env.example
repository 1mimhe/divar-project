PORT=3000
NODE_ENV=development
# Compose dev database (`docker compose up -d`). Point at your own Mongo to skip compose.
MONGODB_URL=mongodb://127.0.0.1:27018/divar-store
JWT_PRIVATE_KEY=change-me-dev-access-secret-min-32-chars
JWT_REFRESH_KEY=change-me-dev-refresh-secret-min-32-chars
COOKIE_PRIVATE_KEY=change-me-dev-cookie-secret-min-32-chars
SESSION_SECRET=change-me-dev-session-secret-min-32-chars
SMS_PROVIDER=mock
# Optional: mobile promoted to admin by `npm run seed`.
ADMIN_MOBILE=
# Optional: database used by the test suite (defaults to divar-store-test on the same host).
TEST_MONGODB_URL=mongodb://127.0.0.1:27018/divar-store-test
